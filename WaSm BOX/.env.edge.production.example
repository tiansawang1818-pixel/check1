# Set these as Supabase Edge Function secrets. Never expose them to Vite.
API_KEY_HASH_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
WEBHOOK_ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_AS_BASE64
WEBHOOK_SIGNING_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
APP_URL=https://YOUR_DOMAIN.example
WEBHOOK_ALLOWED_HOSTS=hooks.YOUR_DOMAIN.example
